name: Generador Automático de Videos Infantiles

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Copiar repositorio
        uses: actions/checkout@v3

      - name: Configurar Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Instalar FFmpeg
        run: |
          sudo apt-get update
          sudo apt-get install -y ffmpeg

      - name: Instalar librerías de Python (MoviePy, gTTS, Pillow)
        run: |
          pip install moviepy gtts pillow

      - name: Ejecutar automatización
        run: python main.py

      - name: Guardar video resultante
        uses: actions/upload-artifact@v3
        with:
          name: video-infantil-automatico
          path: video_final.mp4
